generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserType {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model User {
  email               String                @unique
  name                String
  createdAt           DateTime              @default(now()) @map("created_at")
  isActive            Boolean               @default(true) @map("is_active")
  password            String
  phoneNumber         String?               @map("phone_number")
  surname             String
  userId              String                @id @default(uuid()) @map("user_id")
  username            String                @unique
  userTypeId          Int                   @map("user_type_id")
  store_id            String?               @db.Uuid
  canSeePrice         Boolean               @default(true) @map("can_see_price")
  orders              Order[]
  userType            UserType              @relation(fields: [userTypeId], references: [id])
  Store               Store?                @relation(fields: [store_id], references: [store_id], onUpdate: NoAction, map: "fk_user_store")
  adminCartsCreated   admin_carts[]         @relation("AdminUserCarts")
  adminCartsReceived  admin_carts[]         @relation("TargetUserCarts")
  carts               carts[]
  employeeOrderStats  EmployeeOrderStats[]  @relation("EmployeeOrderStats")
  inAppNotifications  InAppNotification[]
  notificationHistory NotificationHistory[]
  passwordResetTokens PasswordResetToken[]
}

model Collection {
  collectionId              String                      @id @default(uuid()) @map("collection_id")
  name                      String
  description               String?
  code                      String                      @unique
  isActive                  Boolean                     @default(true) @map("is_active")
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  PriceListDetail           PriceListDetail[]
  PurchasePriceListDetail   PurchasePriceListDetail[]
  products                  Product[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Product {
  productId         String              @id @default(uuid()) @map("product_id")
  name              String
  description       String
  productImage      String?             @map("product_imageurl")
  collectionId      String              @map("collection_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  rule_id           Int?
  orderItems        OrderItem[]
  collection        Collection          @relation(fields: [collectionId], references: [collectionId])
  productrules      productrules?       @relation(fields: [rule_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  qr_codes          QRCode[]
  barcodes          Barcode[]
  admin_cart_items  admin_cart_items[]
  cart_items        cart_items[]
  productvariations productvariations[]
  manuelSatisDetay  ManuelSatisDetay[]
}

model PriceList {
  price_list_id   String            @id @default(dbgenerated("gen_random_uuid()"))
  name            String            @db.VarChar(255)
  description     String?
  is_default      Boolean           @default(false)
  valid_from      DateTime?         @db.Timestamp(6)
  valid_to        DateTime?         @db.Timestamp(6)
  limit_amount    Decimal?          @db.Decimal(10, 2)
  currency        String            @db.VarChar(3)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  PriceListDetail PriceListDetail[]
  StorePriceList  StorePriceList[]
}

model PriceListDetail {
  price_list_detail_id   String     @id @default(dbgenerated("gen_random_uuid()"))
  price_list_id          String
  collection_id          String
  price_per_square_meter Decimal    @db.Decimal(10, 2)
  created_at             DateTime   @default(now()) @db.Timestamp(6)
  updated_at             DateTime   @default(now()) @db.Timestamp(6)
  Collection             Collection @relation(fields: [collection_id], references: [collectionId], onDelete: Cascade, onUpdate: NoAction)
  PriceList              PriceList  @relation(fields: [price_list_id], references: [price_list_id], onDelete: NoAction, onUpdate: NoAction)
}

model Store {
  store_id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kurum_adi           String                 @db.VarChar(255)
  vergi_numarasi      String?                @db.VarChar(20)
  vergi_dairesi       String?                @db.VarChar(100)
  yetkili_adi         String?                @db.VarChar(100)
  yetkili_soyadi      String?                @db.VarChar(100)
  telefon             String?                @db.VarChar(20)
  eposta              String?                @db.VarChar(255)
  adres               String?
  faks_numarasi       String?                @db.VarChar(20)
  aciklama            String?
  limitsiz_acik_hesap Boolean?               @default(false)
  acik_hesap_tutari   Decimal?               @default(0) @db.Decimal(15, 2)
  is_active           Boolean?               @default(true)
  created_at          DateTime?              @default(now()) @db.Timestamp(6)
  updated_at          DateTime?              @default(now()) @db.Timestamp(6)
  bakiye              Decimal?               @default(0) @db.Decimal(15, 2)
  maksimum_taksit     Int?                   @default(1)
  tckn                String?                @db.VarChar(11)
  store_type          StoreType?             @default(KARGO) @map("store_type")
  currency            Currency?              @default(TRY)
  StorePriceList      StorePriceList[]
  User                User[]
  adminCarts          admin_carts[]
  adminStoreConfig    AdminStoreConfig?
  muhasebeHareketleri MuhasebeHareketleri[]
  notificationHistory NotificationHistory[]
  paymentSessions     PaymentSession[]
  paymentTransactions PaymentTransaction[]
  installmentLimits   StoreInstallmentLimit?
  currencySummaries   CurrencySummary[]
  addresses           StoreAddress[]
}

model StorePriceList {
  store_price_list_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  store_id            String    @db.Uuid
  price_list_id       String
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
  PriceList           PriceList @relation(fields: [price_list_id], references: [price_list_id], onDelete: Cascade)
  Store               Store     @relation(fields: [store_id], references: [store_id], onDelete: Cascade)

  @@unique([store_id, price_list_id])
}

model cuttypes {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique @db.VarChar(50)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  productrulecuttypes productrulecuttypes[]
  productvariations   productvariations[]
}

model productrulecuttypes {
  rule_id      Int
  cut_type_id  Int
  cuttypes     cuttypes     @relation(fields: [cut_type_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productrules productrules @relation(fields: [rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([rule_id, cut_type_id])
}

model productrules {
  id                  Int                   @id @default(autoincrement())
  name                String                @unique @db.VarChar(100)
  can_have_fringe     Boolean
  description         String?
  is_active           Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  Product             Product[]
  productrulecuttypes productrulecuttypes[]
  productsizeoptions  productsizeoptions[]
}

model productsizeoptions {
  id                 Int           @id @default(autoincrement())
  rule_id            Int?
  width              Int
  height             Int
  is_optional_height Boolean?      @default(false)
  created_at         DateTime?     @default(now()) @db.Timestamp(6)
  updated_at         DateTime?     @default(now()) @db.Timestamp(6)
  productrules       productrules? @relation(fields: [rule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rule_id, width, height, is_optional_height])
}

model productvariations {
  id             Int       @id @default(autoincrement())
  product_id     String?   @db.VarChar(255)
  cut_type_id    Int?
  has_fringe     Boolean   @default(false)
  width          Int
  height         Int
  stock_quantity Int       @default(0)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  stock_area_m2  Decimal?  @default(0) @db.Decimal(10, 2)
  cuttypes       cuttypes? @relation(fields: [cut_type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Product        Product?  @relation(fields: [product_id], references: [productId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, cut_type_id, has_fringe, width, height])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id          Int            @id @default(autoincrement())
  cart_id     Int
  product_id  String         @db.VarChar(36)
  quantity    Int            @default(1)
  width       Decimal        @db.Decimal(8, 2)
  height      Decimal        @db.Decimal(8, 2)
  area_m2     Decimal        @db.Decimal(10, 2)
  unit_price  Decimal        @db.Decimal(10, 2)
  total_price Decimal        @db.Decimal(12, 2)
  has_fringe  Boolean?       @default(false)
  cut_type    cut_type_enum? @default(rectangle)
  notes       String?
  created_at  DateTime?      @default(now()) @db.Timestamp(6)
  updated_at  DateTime?      @default(now()) @db.Timestamp(6)
  carts       carts          @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Product     Product        @relation(fields: [product_id], references: [productId], onDelete: Cascade, onUpdate: NoAction)

  @@index([cart_id], map: "idx_cart_items_cart_id")
  @@index([cart_id, product_id], map: "idx_cart_items_composite")
  @@index([product_id], map: "idx_cart_items_product_id")
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    String       @db.VarChar(36)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  updated_at DateTime?    @default(now()) @db.Timestamp(6)
  is_active  Boolean?     @default(true)
  Order      Order?
  cart_items cart_items[]
  User       User         @relation(fields: [user_id], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([updated_at], map: "idx_carts_updated_at")
  @@index([user_id, is_active], map: "idx_carts_user_active")
  @@index([user_id], map: "idx_carts_user_id")
}

/// Admin sepeti tablosu - Admin tarafından kullanıcılar için oluşturulan sepetler
model admin_carts {
  id               Int                @id @default(autoincrement())
  admin_user_id    String             @db.VarChar(36)
  target_user_id   String             @db.VarChar(36)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  is_active        Boolean?           @default(true)
  notes            String?
  store_id         String             @db.Uuid
  admin_cart_items admin_cart_items[]
  AdminUser        User               @relation("AdminUserCarts", fields: [admin_user_id], references: [userId], onDelete: Cascade, onUpdate: NoAction)
  Store            Store              @relation(fields: [store_id], references: [store_id], onDelete: Cascade, onUpdate: NoAction)
  TargetUser       User               @relation("TargetUserCarts", fields: [target_user_id], references: [userId], onDelete: Cascade, onUpdate: NoAction)

  @@index([admin_user_id], map: "idx_admin_carts_admin_user")
  @@index([target_user_id], map: "idx_admin_carts_target_user")
  @@index([store_id], map: "idx_admin_carts_store")
  @@index([target_user_id, is_active], map: "idx_admin_carts_target_active")
  @@index([updated_at], map: "idx_admin_carts_updated_at")
}

/// Admin sepet öğeleri tablosu
model admin_cart_items {
  id            Int            @id @default(autoincrement())
  admin_cart_id Int
  product_id    String         @db.VarChar(36)
  quantity      Int            @default(1)
  width         Decimal        @db.Decimal(8, 2)
  height        Decimal        @db.Decimal(8, 2)
  area_m2       Decimal        @db.Decimal(10, 2)
  unit_price    Decimal        @db.Decimal(10, 2)
  total_price   Decimal        @db.Decimal(12, 2)
  has_fringe    Boolean?       @default(false)
  cut_type      cut_type_enum? @default(rectangle)
  notes         String?
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  updated_at    DateTime?      @default(now()) @db.Timestamp(6)
  admin_carts   admin_carts    @relation(fields: [admin_cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Product       Product        @relation(fields: [product_id], references: [productId], onDelete: Cascade, onUpdate: NoAction)

  @@index([admin_cart_id], map: "idx_admin_cart_items_cart_id")
  @@index([admin_cart_id, product_id], map: "idx_admin_cart_items_composite")
  @@index([product_id], map: "idx_admin_cart_items_product_id")
}

model Order {
  id                 String              @id @default(uuid())
  user_id            String
  cart_id            Int?                @unique  // Normal sepet için, admin sepetler için null
  admin_cart_id      Int?                // Admin sepet için, normal sepetler için null
  total_price        Decimal             @db.Decimal(12, 2)
  status             OrderStatus         @default(PENDING)
  address_id         String?             // StoreAddress ID'si
  store_name         String?
  store_tax_number   String?
  store_tax_office   String?
  store_phone        String?
  store_email        String?
  store_fax          String?
  notes              String?             // Sipariş notları
  receipt_printed    Boolean             @default(false) @map("receipt_printed")
  receipt_printed_at DateTime?           @map("receipt_printed_at")
  
  // YENI ALANLAR - Currency tracking
  order_currency     Currency?           @default(TRY) @map("order_currency")
  payment_currency   Currency?           @default(TRY) @map("payment_currency")
  exchange_rate      Decimal?            @db.Decimal(10, 4) @map("exchange_rate")
  original_amount    Decimal?            @db.Decimal(12, 2) @map("original_amount")
  converted_amount   Decimal?            @db.Decimal(12, 2) @map("converted_amount")
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  cart               carts?              @relation(fields: [cart_id], references: [id])
  user               User                @relation(fields: [user_id], references: [userId])
  address            StoreAddress?       @relation("OrderAddress", fields: [address_id], references: [id])
  items              OrderItem[]
  qr_codes           QRCode[]
  barcodes           Barcode[]
  employeeOrderStats EmployeeOrderStats? @relation("OrderEmployeeStats")
  muhasebeHareketleri MuhasebeHareketleri[]
}

model OrderItem {
  id          String   @id @default(uuid())
  order_id    String
  product_id  String   @db.VarChar(36)
  quantity    Int
  unit_price  Decimal  @db.Decimal(10, 2)
  total_price Decimal  @db.Decimal(12, 2)
  has_fringe  Boolean?
  width       Decimal? @db.Decimal(8, 2)
  height      Decimal? @db.Decimal(8, 2)
  cut_type    String?
  notes       String?  // Ürün notları
  order       Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [product_id], references: [productId])
  qr_codes    QRCode[]
  barcodes    Barcode[]
}

model QRCode {
  id                      String     @id @default(uuid())
  order_id                String
  qr_code                 String     @unique
  is_scanned              Boolean    @default(false)
  scanned_at              DateTime?
  created_at              DateTime   @default(now())
  required_scans          Int?       @default(2)
  scan_count              Int?       @default(0)
  last_scan_at            DateTime?
  qrCodeImageUrl          String?    @map("qr_code_image_url")
  order_item_id           String?
  product_id              String?    @db.VarChar(36)
  first_scan_at           DateTime?  @map("first_scan_at")
  first_scan_employee_id  String?    @map("first_scan_employee_id") @db.VarChar(36)
  second_scan_at          DateTime?  @map("second_scan_at")
  second_scan_employee_id String?    @map("second_scan_employee_id") @db.VarChar(36)
  order                   Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_item              OrderItem? @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  product                 Product?   @relation(fields: [product_id], references: [productId], onDelete: Cascade)

  @@index([order_id], map: "idx_qr_code_order_id")
  @@index([order_item_id], map: "idx_qr_code_order_item_id")
  @@index([product_id], map: "idx_qr_code_product_id")
}

model Barcode {
  id              String     @id @default(uuid())
  order_id        String
  order_item_id   String
  product_id      String?    @db.VarChar(36)
  barcode         String     @unique
  barcode_type    String     @default("CODE128") // CODE128, QR, EAN13, etc.
  barcode_image_url String?  @map("barcode_image_url") // Barkod görseli URL'si
  is_scanned      Boolean    @default(false)
  scanned_at      DateTime?
  scanned_by      String?    @db.VarChar(36) // User ID of who scanned
  created_at      DateTime   @default(now())
  quantity        Int        @default(1) // How many items this barcode represents
  scan_count      Int        @default(0) // Kaç kez okutuldu
  required_scans  Int        @default(1) // Kaç kez okutulması gerekiyor (quantity ile aynı)
  last_scan_at    DateTime?  @map("last_scan_at") // Son okutma zamanı
  order           Order      @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_item      OrderItem  @relation(fields: [order_item_id], references: [id], onDelete: Cascade)
  product         Product?   @relation(fields: [product_id], references: [productId], onDelete: Cascade)

  @@index([order_id], map: "idx_barcode_order_id")
  @@index([order_item_id], map: "idx_barcode_order_item_id")
  @@index([product_id], map: "idx_barcode_product_id")
  @@index([barcode], map: "idx_barcode_code")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model StoreInstallmentLimit {
  id                           String   @id @default(uuid())
  store_id                     String   @unique @db.Uuid
  consumer_installment_limit   String
  commercial_installment_limit String
  is_active                    Boolean  @default(true)
  created_at                   DateTime @default(now())
  updated_at                   DateTime @updatedAt
  store                        Store    @relation(fields: [store_id], references: [store_id])

  @@map("store_installment_limits")
}

model MuhasebeHareketleri {
  id                Int                  @id @default(autoincrement())
  storeId           String               @map("store_id") @db.Uuid
  islemTuru         String               @map("islem_turu") @db.VarChar(255)
  tutar             Decimal              @db.Decimal(10, 2)
  harcama           Boolean
  tarih             DateTime
  aciklama          String?
  createdAt         DateTime             @default(now()) @map("created_at")
  isManuelSatis     Boolean?             @default(false) @map("is_manuel_satis")
  fisNumarasi       String?              @unique @map("fis_numarasi") @db.VarChar(50)
  
  // YENI ALANLAR - Currency tracking
  currency          Currency?            @default(TRY) @map("currency")
  original_currency Currency?            @default(TRY) @map("original_currency")
  exchange_rate     Decimal?             @db.Decimal(10, 4) @map("exchange_rate")
  original_amount   Decimal?             @db.Decimal(10, 2) @map("original_amount")
  order_id          String?              @map("order_id") // Sipariş ile ilişki
  
  store             Store                @relation(fields: [storeId], references: [store_id])
  order             Order?               @relation(fields: [order_id], references: [id])
  manuelSatisDetay  ManuelSatisDetay[]

  @@map("muhasebe_hareketleri")
}

model ManuelSatisDetay {
  id                Int                    @id @default(autoincrement())
  muhasebeHareketId Int                    @map("muhasebe_hareket_id")
  productId         String                 @map("product_id") @db.VarChar(36)
  quantity          Int
  width             Decimal?               @db.Decimal(8, 2)
  height            Decimal?               @db.Decimal(8, 2)
  unitPrice         Decimal                @map("unit_price") @db.Decimal(10, 2)
  totalPrice        Decimal                @map("total_price") @db.Decimal(12, 2)
  hasFringe         Boolean?               @map("has_fringe")
  cutType           String?                @map("cut_type") @db.VarChar(100)
  notes             String?
  createdAt         DateTime               @default(now()) @map("created_at")
  
  muhasebeHareketi  MuhasebeHareketleri    @relation(fields: [muhasebeHareketId], references: [id], onDelete: Cascade)
  product           Product                @relation(fields: [productId], references: [productId], onDelete: Restrict)

  @@map("manuel_satis_detay")
}

model AdminVarliklari {
  id           Int     @id @default(1)
  kasaBakiyesi Decimal @default(0) @map("kasa_bakiyesi") @db.Decimal(15, 2)

  @@map("admin_varliklari")
}

model AdminStoreConfig {
  id           Int      @id @default(autoincrement())
  storeId      String   @unique @map("store_id") @db.Uuid
  isAdminStore Boolean  @default(true) @map("is_admin_store")
  description  String?  @map("description")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  store        Store    @relation(fields: [storeId], references: [store_id], onDelete: Cascade)

  @@map("admin_store_config")
}

model ExchangeRate {
  id              String   @id @default(uuid())
  source_currency Currency @default(TRY)
  target_currency Currency @default(USD)
  rate            Decimal  @db.Decimal(10, 4)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([source_currency, target_currency])
  @@map("exchange_rates")
}

model ContactForm {
  id           Int      @id @default(autoincrement())
  companyName  String   @map("company_name") @db.VarChar(200)
  authorityName String  @map("authority_name") @db.VarChar(100)
  authoritySurname String @map("authority_surname") @db.VarChar(100)
  email        String   @db.VarChar(150)
  phone        String   @db.VarChar(20)
  address      String   @db.Text
  isRead       Boolean  @default(false) @map("is_read")
  isContacted  Boolean  @default(false) @map("is_contacted")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("contact_forms")
}

model DbyeOdemeLogin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  url       String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dbye_odeme_login")
}

model DbyeConfig {
  id            Int      @id @default(1)
  webhookSecret String   @map("webhook_secret") @db.VarChar(500)
  backendUrl    String   @map("backend_url") @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  description   String?  @map("description")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("dbye_config")
}

model PaymentTransaction {
  id                 String        @id @default(uuid())
  storeId            String        @map("store_id") @db.Uuid
  sellerReference    String        @unique @map("seller_reference")
  apiReferenceNumber String        @unique @map("api_reference_number")
  amount             Decimal       @db.Decimal(10, 2)
  description        String        @map("description")
  status             PaymentStatus @default(PENDING)
  webhookToken       String?       @map("webhook_token")
  webhookData        Json?         @map("webhook_data")
  octetPaymentId     String?       @map("octet_payment_id")
  paymentDate        DateTime?     @map("payment_date")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  
  // YENI ALANLAR - Currency tracking
  store_currency     Currency?     @default(TRY) @map("store_currency")
  payment_currency   Currency?     @default(TRY) @map("payment_currency")
  exchange_rate      Decimal?      @db.Decimal(10, 4) @map("exchange_rate")
  original_amount    Decimal?      @db.Decimal(12, 2) @map("original_amount")
  converted_amount   Decimal?      @db.Decimal(12, 2) @map("converted_amount")
  
  store              Store         @relation(fields: [storeId], references: [store_id])

  @@map("payment_transactions")
}

model EmployeeOrderStats {
  id              Int      @id @default(autoincrement())
  employeeId      String   @map("employee_id") @db.VarChar(36)
  orderId         String   @unique @map("order_id")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  totalAreaM2     Decimal  @map("total_area_m2") @db.Decimal(10, 2)
  totalItems      Int      @map("total_items")
  completedAt     DateTime @map("completed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  deliveredAreaM2 Decimal? @map("delivered_area_m2") @db.Decimal(10, 2)
  orderStatus     String?  @map("order_status")
  preparedAreaM2  Decimal? @map("prepared_area_m2") @db.Decimal(10, 2)
  employee        User     @relation("EmployeeOrderStats", fields: [employeeId], references: [userId], onDelete: Cascade)
  order           Order    @relation("OrderEmployeeStats", fields: [orderId], references: [id], onDelete: Cascade)

  @@map("employee_order_stats")
}

model PaymentSession {
  id             String         @id @default(uuid())
  orderId        String?        @map("order_id")
  channel        PaymentChannel @default(WEB)
  status         SessionStatus  @default(PENDING)
  idempotencyKey String?        @unique @map("idempotency_key")
  webhookToken   String?        @unique @map("webhook_token")
  paymentUrl     String?        @map("payment_url")
  storeId        String         @map("store_id") @db.Uuid
  amount         Decimal        @db.Decimal(10, 2)
  description    String?
  createdAt      DateTime       @default(now()) @map("created_at")
  expiresAt      DateTime       @map("expires_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  store          Store          @relation(fields: [storeId], references: [store_id])

  @@map("payment_sessions")
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  orderId   String?  @map("order_id")
  metadata  String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("in_app_notifications")
}

model NotificationHistory {
  id       String   @id @default(uuid())
  userId   String?  @map("user_id")
  type     String
  title    String
  message  String
  orderId  String?  @map("order_id")
  metadata String?
  sentAt   DateTime @default(now()) @map("sent_at")
  storeId  String?  @map("store_id") @db.Uuid
  store    Store?   @relation(fields: [storeId], references: [store_id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("notification_history")
}

model StoreAddress {
  id          String   @id @default(uuid())
  store_id    String   @db.Uuid
  title       String   // "Ana Mağaza", "Depo", "Şube 1" gibi
  address     String   // Tam adres
  city        String?  // Şehir
  district    String?  // İlçe
  postal_code String?  // Posta kodu
  is_default  Boolean  @default(false) // Varsayılan adres
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  store       Store    @relation(fields: [store_id], references: [store_id], onDelete: Cascade)
  orders      Order[]  @relation("OrderAddress")

  @@map("store_addresses")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
  READY
}

enum Currency {
  TRY
  USD
  EUR
}

enum cut_type_enum {
  rectangle
  round
  oval
  custom
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentChannel {
  WEB
  MOBILE
}

enum SessionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum StoreType {
  KARGO      // Kargo - adres telefon ve ürün bilgileri
  SERVIS     // Servis - müşteri adı ürün adı ebat kesim türü
  KENDI_ALAN // Kendi alan - müşteri adı ürün adı ebat kesim türü  
  AMBAR      // Ambar - adres telefon ve ürün bilgileri
}

// YENI TABLO - Currency özet verileri için
model CurrencySummary {
  id                String    @id @default(uuid())
  store_id          String    @db.Uuid
  currency          Currency
  period_start      DateTime
  period_end        DateTime
  total_revenue     Decimal   @db.Decimal(12, 2)
  total_orders      Int
  average_rate      Decimal?  @db.Decimal(10, 4)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  
  store             Store     @relation(fields: [store_id], references: [store_id])
  
  @@unique([store_id, currency, period_start, period_end])
  @@map("currency_summaries")
}

// Satıcılar tablosu
model Supplier {
  id                    String                      @id @default(uuid())
  name                  String                      @db.VarChar(255)
  company_name          String                      @map("company_name") @db.VarChar(255)
  phone                 String?                     @db.VarChar(20)
  address               String?
  notes                 String?
  balance               Decimal                     @default(0) @db.Decimal(15, 2) // Pozitif: Alacak, Negatif: Borç
  currency              Currency                    @default(USD)
  is_active             Boolean                     @default(true) @map("is_active")
  created_at            DateTime                    @default(now()) @map("created_at")
  updated_at            DateTime                    @updatedAt @map("updated_at")
  purchasePriceLists    PurchasePriceList[]
  balanceTransactions   SupplierBalanceTransaction[]

  @@map("suppliers")
}

// Alış fiyat listesi tablosu
model PurchasePriceList {
  id              String                      @id @default(uuid())
  name            String                      @db.VarChar(255)
  description     String?
  supplier_id     String?                     @map("supplier_id")
  currency        Currency                    @default(USD)
  is_active       Boolean                     @default(true) @map("is_active")
  created_at      DateTime                    @default(now()) @map("created_at")
  updated_at      DateTime                    @updatedAt @map("updated_at")
  supplier        Supplier?                   @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  details         PurchasePriceListDetail[]

  @@map("purchase_price_lists")
}

// Alış fiyat listesi detayları
model PurchasePriceListDetail {
  id                      String            @id @default(uuid())
  purchase_price_list_id  String            @map("purchase_price_list_id")
  collection_id           String            @map("collection_id")
  price_per_square_meter  Decimal           @db.Decimal(10, 2) @map("price_per_square_meter")
  created_at              DateTime          @default(now()) @map("created_at")
  updated_at              DateTime          @updatedAt @map("updated_at")
  purchasePriceList       PurchasePriceList @relation(fields: [purchase_price_list_id], references: [id], onDelete: Cascade)
  collection              Collection        @relation(fields: [collection_id], references: [collectionId], onDelete: Cascade)

  @@unique([purchase_price_list_id, collection_id])
  @@map("purchase_price_list_details")
}

// Satıcı bakiye işlemleri tablosu
model SupplierBalanceTransaction {
  id                String            @id @default(uuid())
  supplier_id       String            @map("supplier_id")
  transaction_type  String            @map("transaction_type") @db.VarChar(50) // PAYMENT, PURCHASE, ADJUSTMENT, etc.
  amount            Decimal           @db.Decimal(15, 2) // USD cinsinden tutar (amount/exchange_rate)
  original_amount   Decimal?          @map("original_amount") @db.Decimal(15, 2) // Orijinal TRY tutar
  exchange_rate     Decimal?          @map("exchange_rate") @db.Decimal(10, 4) // Dolar kuru
  original_currency String?           @map("original_currency") @db.VarChar(3) @default("TRY") // Orijinal para birimi
  previous_balance  Decimal           @map("previous_balance") @db.Decimal(15, 2)
  new_balance       Decimal           @map("new_balance") @db.Decimal(15, 2)
  description       String?
  reference_number  String?           @map("reference_number") @db.VarChar(100)
  created_by        String            @map("created_by") @db.VarChar(36) // Admin user ID
  created_at        DateTime          @default(now()) @map("created_at")
  supplier          Supplier          @relation(fields: [supplier_id], references: [id], onDelete: Cascade)

  @@map("supplier_balance_transactions")
}
