
# Sunucu ayarları
PORT=3001
PUBLIC_URL="http://localhost:3001"
NODE_ENV="development"

# Production URL (Railway)
# PUBLIC_URL="https://pasha-backend-production.up.railway.app"

# JWT Secret
JWT_SECRET="your-jwt-secret-key-here"

# JWT Token Süresi (saniye cinsinden)
# 3600 = 1 saat, 28800 = 8 saat, 86400 = 24 saat
JWT_EXPIRES_IN=3600

# Veritabanı bağlantısı
DATABASE_URL="postgresql://username:password@localhost:5432/pasha_db?schema=public"

